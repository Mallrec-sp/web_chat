# 本地开发模板。建议运行 node scripts/init-env.mjs 生成互不相同的随机密码。
# 不要把含真实密码的 .env 提交到 Git。
MYSQL_ROOT_PASSWORD=
NETCHAT_APP_PASSWORD=
NETCHAT_MIGRATION_PASSWORD=
NETCHAT_MYSQL_PORT=3306
NETCHAT_HTTP_PORT=8081

# 外部 MySQL（复制到 .env.production 填写；使用 compose.external.yml）
# NETCHAT_DB_HOST=mysql.example.internal
# NETCHAT_DB_PORT=3306
# NETCHAT_DB_NAME=netchat
# NETCHAT_DB_USER=netchat_app
# NETCHAT_DB_PASSWORD=
# NETCHAT_MIGRATION_USER=netchat_migrator
# NETCHAT_DB_CA_FILE=/absolute/path/to/provider-ca.pem
# NETCHAT_HTTP_BIND=127.0.0.1
